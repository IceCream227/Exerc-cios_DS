<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        @import url('https://fonts.cdnfonts.com/css/valorant');
        @import "@fontsource/roboto/500.css";

        h1, h2, h3 {
            font-family: 'Valorant', sans-serif;
        }

        h1{
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }
        h2{
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }
        p{
            font-family: 'Roboto', sans-serif;
            margin-bottom: 1rem;
        }
        span{
            font-family: 'Roboto', sans-serif;
            margin-bottom: 1rem;
        }

        * {
            padding: 0;
            margin: 0;
            box-sizing: border-box;
        }

        table {
            margin: 0 auto;
            border: none;
            box-shadow: 0 1px 15px #FD4556;
            border-radius: 5px;
        }

        ul {
            list-style-type: none;
        }

        header {
            background-color: #000000;
            text-align: center;
            border-radius: 4px;
            padding: 1.5rem;
            box-shadow: 0 2px 12px #FD4556;
            color: #FFF;
        }

        footer {
            background-color: #000000;
            text-align: center;
            border-radius: 4px;
            padding: 1.5rem;
            box-shadow: 0 0 12px #FD4556;
            color: #fff;
        }
        td, th{
            padding: 0.5rem;
            border: none;
            transition: transform 0.5s ease;
        }
        td:nth-child(1):hover{
            transform: scale(1.2);
        }
        td:nth-child(1):active{
            transform: scale(0.5);
        }
        .btn {
            background-color: #53212B;
            border: none;
            transition: 0.5s ease;
            font-family: 'Valorant', sans-serif;
            color: #a0a0a0;
            padding: 0.313rem;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn:hover {
            background-color: #BD3944;
            color: #fff;
            box-shadow: 0 1px 12px #FD4556;
        }

        #principal {
            background-color: #FFF;
            text-align: center;
            border-radius: 4px;
            padding: 1.25rem;
            border: 2px solid #ccc;
            border-radius: 4px;
            width: 60vw;
            margin: 0 auto;
            margin-top: 1.25rem;
        }

        #conteudos {
            background-color: #FFF;
            text-align: center;
            border-radius: 4px;
            padding: 1.25rem;
            border: 2px solid #ccc;
            border-radius: 4px;
            width: 60vw;
            margin: 0 auto;
            margin-top: 1.25rem;
            margin-bottom: 1.25rem;
        }

        .lista {
            margin-top: 0.625rem;
            width: 30vw;
            max-width: 30vw;
            margin: 0 auto;
            padding-top: 1.25rem;
        }

        .lista img {
            display: block;
            width: 0%;
            transition: all 0.5s ease;
            margin: 0 auto;
        }

        .lista:hover img {
            display: block;
            width: 10vw;
            background-color: #fafafaa9;
            padding: 1.25rem;
            border-radius: 5px;
            box-shadow: 0 0 2px #000000;
        }

        .carousel-conteiner {
            max-width: 40vw;
            width: 100%;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.25);
            border-radius: 10px;
            margin: 0 auto;
            position: relative;
            aspect-ratio: 16 / 9;
        }

        .slides {
            display: flex;
            transition: transform 0.5s ease-in-out;
            transform: translateX(0);
        }

        .slides img {
            display: block;
            width: 100%;
            min-width: 100%;
            object-fit: cover;
        }

        button.prev,
        button.next {
            position: absolute;
            top: 50%;
            background-color: rgba(0, 0, 0, 0.767);
            color: white;
            border: none;
            padding: 0.313rem;
            cursor: pointer;
            font-size: 15px;
            z-index: 10;
            border-radius: 5px;
            margin: 0 10px;
            transition: transform 0.5s ease;
        }

        button:hover {
            transform: scale(1.1);
        }

        button:active {
            transform: scale(0.5);
        }

        .next {
            right: 0;
        }

        .prev {
            left: 0;
        }
        @media screen and (max-width: 820px) {
            .lista img{
                width: 30vw;
                opacity: 1;
            }
        }
        @media screen and (max-width: 768px) { 
            h1{
                font-size: 2rem;
            }
            h2{
                font-size: 1.75rem;
            }
            .lista img{
                width: 30vw;
                opacity: 1;
            }
            .carousel-conteiner{
                max-width: 100%;
                width: 80vw;
            }
        }
        @media screen and (max-width: 576px) {
            h1{
                font-size: 1.75rem;
            }
            h2{
                font-size: 1.45rem;
            }
            .lista img{
                width: 30vw;
                opacity: 1;
            }
            .carousel-conteiner{
                max-width: 100%;
                width: 80vw;
            }
        }
        @media screen and (max-width: 400px) {
            h1{
                font-size: 1.75rem;
            }
            h2{
                font-size: 1rem;
            }
            .lista img{
                width: 30vw;
                opacity: 1;
            }
            .carousel-conteiner{
                max-width: 100%;
                width: 80vw;
            }
        }
    </style>
</head>

<body>
    <header>
        <h1>Valorant</h1>
        <nav>
            <a href="#principal"><button class="btn">Principal Section</button></a><br><br>
            <a href="#conteudos"><button class="btn">Contents</button></a>
        </nav>
    </header>

    <main>
        <section id="principal">
            <div class="carousel-conteiner">
                <div class="slides">
                    <img src="https://i.ytimg.com/vi/q0M5FQbgiQY/hq720.jpg?sqp=-oaymwEhCK4FEIIDSFryq4qpAxMIARUAAAAAGAElAADIQj0AgKJD&rs=AOn4CLDqZXt1p5zECeyDhsUr9crzIOJomw"
                        alt="Slide 1">
                    <img src="https://cmsassets.rgpub.io/sanity/images/dsfx7636/news_live/cf2a712d7ea9b16299ae60ec543408f42c617b72-2048x1414.jpg"
                        alt="Slide 2">
                    <img src="https://cdn-62cb22a2c1ac1835ecef9f37.closte.com/wp-content/uploads/2024/08/imagem_2024-08-26_012428697.png"
                        alt="Slide 3">
                    <img src="https://noticias.maisesports.com.br/wp-content/uploads/2025/10/vrg-campea-valorant-champions-2025.jpg"
                        alt="Slide 4">
                </div>
                <button class="prev">&#10094;</button>
                <button class="next">&#10095;</button>
            </div>
        </section>

        <section id="conteudos">
            <article>
                <h2>Champions Winners - Valorant</h2>
                <ul>
                    <li class="lista">
                        <span>LOUD</span>
                        <img src="https://owcdn.net/img/62bbec8dc1b9f.png" alt="img1">
                    </li>
                    <li class="lista">
                        <span>NRG</span>
                        <img src="https://owcdn.net/img/6610f026c1a9e.png" alt="img2">
                    </li>
                    <li class="lista">
                        <span>EG</span>
                        <img src="https://owcdn.net/img/667462f046618.png" alt="img3">
                    </li>
                    <li class="lista">
                        <span>EDG</span>
                        <img src="https://owcdn.net/img/62c82049253b2.png" alt="img4">
                    </li>
                </ul>
            </article>

            <section>
                <table border="1" style="margin-top: 1.25rem;">
                    <thead>
                        <tr>
                            <th>Team</th>
                            <th>Region</th>
                            <th>Champions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td onclick="window.location='https://www.vlr.gg/team/6961/loud';"
                                style="cursor: pointer; color: #FD4556;">Loud</td>
                            <td>America</td>
                            <td>1</td>
                        </tr>
                        <tr>
                            <td onclick="window.location='https://www.vlr.gg/team/1034/nrg';"
                                style="cursor: pointer; color: #FD4556;">NRG</td>
                            <td>America</td>
                            <td>1</td>
                        </tr>
                        <tr>
                            <td onclick="window.location='https://www.vlr.gg/team/5248/evil-geniuses'"
                                style="cursor: pointer; color: #FD4556;">EG</td>
                            <td>America</td>
                            <td>1</td>
                        </tr>
                        <tr>
                            <td onclick="window.location='https://www.vlr.gg/team/1120/edward-gaming'"
                                style="cursor: pointer; color: #FD4556;">EDG</td>
                            <td>China</td>
                            <td>1</td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </section>
    </main>

    <footer>
        <p>Spin Foot Of The Site</p>
        <p>Contact Informations, etc</p>
    </footer>
    <script>
        const elemSlides = document.querySelector(".slides");
        const elemBtnPrev = document.querySelector(".prev");
        const elemBtnNext = document.querySelector(".next");
        const elemsImg = document.querySelectorAll(".slides img");

        console.log(elemsImg.length);

        const tamanhoLista = elemsImg.length - 1;

        let index = 0;

        elemBtnPrev.addEventListener('click', () => {
            index--;
            if (index < 0) index = tamanhoLista;
            atualizarCarrossel();
            console.log(index);
        });
        elemBtnNext.addEventListener('click', () => {
            index++;
            if (index > tamanhoLista) index = 0;
            atualizarCarrossel();
            console.log(index);
        })

        const atualizarCarrossel = () => {
            elemSlides.style.transform = `translateX(-${index * 100}%)`;
        }
    </script>
</body>

</html>
