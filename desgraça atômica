<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        @import url('https://fonts.cdnfonts.com/css/valorant');

        body {
            font-family: 'Valorant', sans-serif;
            background-color: #fff;
        }

        *{
            padding: 0;
            margin: 0;
            box-sizing: border-box;
        }
        table{
            margin: 0 auto;
        }
        ul{
            list-style-type: none;
            margin-right: 30px;
        }
        header{
            background-color: #000000;
            text-align: center;
            border-radius: 4px;
            padding: 20px;
            box-shadow: 0 2px 12px #FD4556;
            color:#FFF;
        }
        footer{
            background-color: #000000;
            text-align: center;
            border-radius: 4px;
            padding: 20px;
            box-shadow: 0 0 12px #FD4556;
            color: #fff;
        }
        .btn{
            background-color: #53212B;
            border: none;
            transition: 0.5s ease;
            font-family: 'Valorant', sans-serif;
            color: #a0a0a0;
            padding: 5px;
            border-radius: 5px;
            
        }
        .btn:hover{
            background-color: #BD3944;
            color: #fff;
        }
        #principal{
            background-color: #FFF;
            text-align: center;
            border-radius: 4px;
            padding: 20px;
            border: 2px solid #ccc;
            border-radius: 4px;
            width: 60%;
            margin: 0 auto;
            margin-top: 20px;
        }
        #conteudos{
            background-color: #FFF;
            text-align: center;
            border-radius: 4px;
            padding: 20px;
            border: 2px solid #ccc;
            border-radius: 4px;
            width: 60%;
            margin: 0 auto;
            margin-top: 20px;
            margin-bottom: 20px;
        }
        .carousel-conteiner{
            max-width: 400px;
            width: 100%;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.25);
            border-radius: 10px;
            margin: 0 auto;
            position: relative;
        }
        .slides{
            display: flex;
            transition: transform 0.5s ease-in-out;
            transform: translateX(0);
        }
        .slides img{
            display: block;
            width: 100%;
            min-width: 100%;
            object-fit: cover;
        }
        button.prev, button.next {
            position: absolute;
            top: 50%;
            background-color: rgba(0, 0, 0, 0.767);
            color: white;
            border: none;
            padding: 5px;
            cursor: pointer;
            font-size: 15px;
            z-index: 10;
            border-radius: 5px;
            margin: 0 10px;
            transition: transform 0.5s ease;
        }
        button:hover{
            transform: scale(1.1);
        }
        button:active{
            transform: scale(0.5);
        }
        .next{
            right: 0;
        }
        .prev{
            left: 0;
        }
    </style>
</head>
<body>
    <header>
        <h1>Valorant</h1>
        <nav>
            <a href="#principal"><button class="btn">Principal Section</button></a><br><br>
            <a href="#conteudos"><button class="btn">Contents</button></a>
        </nav>
    </header>

    <main>
        <section id="principal">
            <h2>Principal Section</h2>
            <div class="carousel-conteiner">
                <div class="slides">
                    <img src="https://i.ytimg.com/vi/q0M5FQbgiQY/hq720.jpg?sqp=-oaymwEhCK4FEIIDSFryq4qpAxMIARUAAAAAGAElAADIQj0AgKJD&rs=AOn4CLDqZXt1p5zECeyDhsUr9crzIOJomw" alt="Slide 1">
                    <img src="https://cmsassets.rgpub.io/sanity/images/dsfx7636/news_live/cf2a712d7ea9b16299ae60ec543408f42c617b72-2048x1414.jpg" alt="Slide 2">
                    <img src="https://cdn-62cb22a2c1ac1835ecef9f37.closte.com/wp-content/uploads/2024/08/imagem_2024-08-26_012428697.png" alt="Slide 3">
                    <img src="https://noticias.maisesports.com.br/wp-content/uploads/2025/10/vrg-campea-valorant-champions-2025.jpg" alt="Slide 4">
                </div>
                <button class="prev">&#10094;</button>
                <button class="next">&#10095;</button>
            </div>
        </section>

            <section id="conteudos">
                <h2>Contents</h2>
                
                <article>
                    <h2>Champions Winners - Valorant</h2>
                    <ul role="list">
                        <li>Loud</li>
                        <li>NRG</li>
                        <li>EG</li>
                    </ul>
                </article>
                
                <article>
                    <h2>Título 2</h2>
                    <p>Conteúdo do texto 2</p>
                </article>
                    <section>
                <table border="1">
                    <thead>
                        <tr>
                            <th>Team</th>
                            <th>Region</th>
                            <th>Champions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td onclick="window.location='https://www.vlr.gg/team/6961/loud';" style="cursor: pointer; color: blue;">Loud</td>
                            <td>America</td>
                            <td>1</td>
                        </tr>
                        <tr>
                            <td onclick="window.location='https://www.vlr.gg/team/1034/nrg';" style="cursor: pointer; color: blue;">NRG</td>
                            <td>America</td>
                            <td>1</td>
                        </tr>
                        <tr>
                            <td onclick="window.location='https://www.vlr.gg/team/5248/evil-geniuses'" style="cursor: pointer; color: blue;">EG</td>
                            <td>America</td>
                            <td>1</td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </section>
    </main>

    <footer>
        <p>Spin Foot Of The Site</p>
        <p>Contact Informations, etc</p>
    </footer>
    <script>
        const elemSlides = document.querySelector(".slides");
        const elemBtnPrev = document.querySelector(".prev");
        const elemBtnNext = document.querySelector(".next");
        const elemsImg = document.querySelectorAll(".slides img");

        console.log(elemsImg.length);

        const tamanhoLista = elemsImg.length - 1;

        let index = 0;

        elemBtnPrev.addEventListener('click', () =>{
            index--;
            if (index < 0) index = tamanhoLista;
            atualizarCarrossel();
            console.log(index);
        });
        elemBtnNext.addEventListener('click', () =>{
            index++;
            if (index > tamanhoLista) index = 0;
            atualizarCarrossel();
            console.log(index);
        })

        const atualizarCarrossel = () => {
            elemSlides.style.transform = `translateX(-${index * 100}%)`;
        }
    </script>
</body>
</html>
