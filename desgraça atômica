<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        @import url('https://fonts.cdnfonts.com/css/valorant');
        body {
            font-family: 'Valorant', sans-serif;
        }

        *{
            padding: 0;
            margin: 0;
            box-sizing: border-box;
        }
        table{
            margin: 0 auto;
        }
        ul{
            list-style-type: none;
            margin-right: 30px;
        }
        header{
            background-color: white;
            text-align: center;
            border-radius: 4px;
            padding: 20px;
            border-bottom: 2px solid #ccc;
        }
        footer{
            background-color: white;
            text-align: center;
            border-radius: 4px;
            padding: 20px;
            border-top: 2px solid #ccc;
        }
        .carousel-conteiner{
            max-width: 400px;
            width: 100%;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.25);
            border-radius: 10px;
            margin: 0 auto;
            position: relative;
        }
        .slides{
            display: flex;
            transition: transform 0.5s ease-in-out;
            transform: translateX(0);
        }
        .slides img{
            display: block;
            width: 100%;
            min-width: 100%;
            object-fit: cover;
        }
        button.prev, button.next {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background-color: rgba(0, 0, 0, 0.767);
            color: white;
            border: none;
            padding: 5px;
            cursor: pointer;
            font-size: 15px;
            z-index: 10;
            border-radius: 5px;
            margin: 0 10px;
        }
        .next{
            right: 0;
        }
        .prev{
            left: 0;
        }
    </style>
</head>
<body>
    <header>
        <h1>Name</h1>
        <nav>
            <a href="#principal" class="btn"><button>Principal Section</button></a><br><br>
            <a href="#conteudos" class="btn"><button>Contents</button></a>
        </nav>
    </header>

    <main>
        <section id="principal">
            <h2>Principal Section</h2>
            <div class="carousel-conteiner">
                <div class="slides">
                    <img src="https://owcdn.net/img/6988ab636fd3b.jpg" alt="Slide 1">
                    <img src="https://assets.gamearena.gg/wp-content/uploads/2025/03/25104559/MIBR-VCT-Americas-1024x683.jpg" alt="Slide 2">
                    <img src="https://medias.itatiaia.com.br/dims4/default/9ec41b7/2147483647/strip/true/crop/1599x900+0+0/resize/1000x563!/quality/90/?url=https%3A%2F%2Fk2-prod-radio-itatiaia.s3.us-east-1.amazonaws.com%2Fbrightspot%2F73%2F00%2F7010694f4a9c9b8ab29ef96f7838%2Ffuria-valorant-1.png" alt="Slide 3">
                </div>
                <button class="prev">&#10094;</button>
                <button class="next">&#10095;</button>
            </div>
        </section>

        <section id="conteudos">
            <h2>Contents</h2>
            
            <article>
                <h2>Champions Winners - Valorant</h2>
                <ul role="list">
                    <li>Loud</li>
                    <li>NRG</li>
                    <li>EG</li>
                </ul>
            </article>
            
            <article>
                <h2>Título 2</h2>
                <p>Conteúdo do texto 2</p>
            </article>
        </section>

        <section>
            <table border="1">
                <thead>
                    <tr>
                        <th>Team</th>
                        <th>Region</th>
                        <th>Champions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td onclick="window.location='https://www.vlr.gg/team/6961/loud';" style="cursor: pointer; color: blue;">Loud</td>
                        <td>America</td>
                        <td>1</td>
                    </tr>
                    <tr>
                        <td onclick="window.location='https://www.vlr.gg/team/1034/nrg';" style="cursor: pointer; color: blue;">NRG</td>
                        <td>America</td>
                        <td>1</td>
                    </tr>
                    <tr>
                        <td onclick="window.location='https://www.vlr.gg/team/5248/evil-geniuses'" style="cursor: pointer; color: blue;">EG</td>
                        <td>America</td>
                        <td>1</td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>

    <footer>
        <p>Spin Foot Of The Site</p>
        <p>Contact Informations, etc</p>
    </footer>
    <script>
        const elemSlides = document.querySelector(".slides");
        const elemBtnPrev = document.querySelector(".prev");
        const elemBtnNext = document.querySelector(".next");
        const elemsImg = document.querySelectorAll(".slides img");

        console.log(elemsImg.length);

        const tamanhoLista = elemsImg.length - 1;

        let index = 0;

        elemBtnPrev.addEventListener('click', () =>{
            index--;
            if (index < 0) index = tamanhoLista;
            atualizarCarrossel();
            console.log(index);
        });
        elemBtnNext.addEventListener('click', () =>{
            index++;
            if (index > tamanhoLista) index = 0;
            atualizarCarrossel();
            console.log(index);
        })

        const atualizarCarrossel = () => {
            elemSlides.style.transform = `translateX(-${index * 100}%)`;
        }
    </script>
</body>
</html>
