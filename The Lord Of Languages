<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Academia de Runas de Erebor</title>
    <style>
        /* Importação fictícia - certifique-se de que os caminhos estão corretos no seu projeto */
        @font-face {
            font-family: 'Ringbearer';
            src: url('./ringbearer/RINGM___.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        @font-face {
            font-family: 'Celtic';
            src: url('./celtic_garamond_the_2nd/CELTG___.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        :root {
            --cor-fundo: #EEE0C7;
            --cor-header-footer: #636B2F;
            --cor-texto-claro: #fff;
            --cor-texto-escuro: #3d2b1f; /* Cor para leitura no pergaminho */
            --cor-box: #3f41381a; /* Suavizado para não esconder o fundo */
            --cor-btn1: #7C4919;
            --cor-btn2: #EB8A2F;
            --cor-brilho: #F3B900;
            --borda-medieval: 2px double #7C4919;
        }

        * {
            padding: 0;
            margin: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--cor-fundo);
            /* Adiciona uma textura leve de papel antigo */
            background-image: url('https://www.transparenttextures.com/patterns/parchment.png');
            color: var(--cor-texto-escuro);
            line-height: 1.6;
        }

        h1, h2, h3 {
            font-family: 'Ringbearer', serif;
            color: var(--cor-texto-escuro);
            margin-bottom: 1rem;
            letter-spacing: 1px;
        }

        p, span, li {
            font-family: 'Celtic', serif;
            font-size: 1.1rem;
        }

        header {
            background-color: var(--cor-header-footer);
            text-align: center;
            padding: 2.5rem 1.5rem;
            color: var(--cor-texto-claro);
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            border-bottom: 4px solid var(--cor-btn1);
        }

        header h1 {
            color: var(--cor-texto-claro);
            font-size: 2.5rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        nav {
            margin-top: 1.5rem;
        }

        footer {
            background-color: var(--cor-header-footer);
            text-align: center;
            padding: 2rem;
            color: #fff;
            margin-top: 3rem;
            border-top: 4px solid var(--cor-btn1);
        }

        .btn {
            background-color: var(--cor-btn1);
            border: 1px solid var(--cor-brilho);
            transition: 0.4s all ease;
            font-family: 'Celtic', serif;
            color: var(--cor-texto-claro);
            padding: 0.6rem 1.2rem;
            border-radius: 3px;
            cursor: pointer;
            margin: 5px;
            text-transform: uppercase;
        }

        .btn:hover {
            background-color: var(--cor-btn2);
            color: #000;
            box-shadow: 0 0 15px var(--cor-brilho);
            transform: translateY(-2px);
        }

        .plans{
            transition: 0.3s ease;
        }

        .plans:hover{
            transform: scale(1.1);
        }

        #planos{
            display:flex;
            gap: 20px;
            flex: 1;
        }

        section {
            background-color: rgba(255, 255, 255, 0.3);
            text-align: center;
            padding: 2.5rem;
            border-radius: 8px;
            border: var(--borda-medieval);
            width: 70vw;
            margin: 2rem auto;
            box-shadow: 5px 5px 15px rgba(0,0,0,0.1);
        }

        /* Estilização específica para as imagens de runas */
        article img {
            margin-top: 1.5rem;
            border-radius: 5px;
            filter: sepia(0.3) contrast(1.1);
            transition: 0.3s;
            max-width: 80%;
        }

        article img:hover {
            filter: sepia(0);
            transform: scale(1.02);
        }

        .carousel-conteiner {
            max-width: 90%;
            width: 100%;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
            border: 3px solid var(--cor-btn1);
            border-radius: 10px;
            margin: 0 auto;
            position: relative;
        }

        .slides {
            display: flex;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .slides img {
            display: block;
            width: 100%;
            min-width: 100%;
            height: 400px;
            object-fit: cover;
        }

        button.prev, button.next {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background-color: rgba(61, 43, 31, 0.8);
            color: var(--cor-brilho);
            border: 1px solid var(--cor-brilho);
            padding: 1rem 0.5rem;
            cursor: pointer;
            font-size: 20px;
            z-index: 10;
            transition: 0.3s;
        }

        button.prev { left: 0; border-radius: 0 5px 5px 0; }
        button.next { right: 0; border-radius: 5px 0 0 5px; }

        button.prev:hover, button.next:hover {
            background-color: var(--cor-btn2);
            color: #fff;
        }

        /* Responsividade */
        @media screen and (max-width: 768px) { 
            section { width: 90vw; padding: 1.5rem; }
            header h1 { font-size: 1.8rem; }
            .slides img { height: 250px; }
        }
    </style>
</head>

<body>
    <header>
        <h1>A Academia de Runas de Erebor</h1>
        <nav>
            <a href="#RF"><button class="btn">Runas Futhorc</button></a>
            <a href="#RE"><button class="btn">Runas Élficas</button></a>
            <a href="#RA"><button class="btn">Runas Antigas</button></a>
            <a href="#PLA"><button class="btn">Planos</button></a>
        </nav>
    </header>

    <main>
        <section id="principal">
            <div class="carousel-conteiner">
                <div class="slides">
                    <img src="https://acdn-us.mitiendanube.com/stores/004/823/295/products/vintage-canvas-sn-5ff2176c29e86c24bf17266231791544-1024-1024.png" alt="Mapa da Terra Média">
                    <img src="https://mundodosjogos.org/wp-content/uploads/2024/05/2507-valfenda-o-senhor-dos-aneis.webp" alt="Valfenda">
                    <img src="https://i.pinimg.com/736x/44/12/d6/4412d6e2a2328c631e71d68e14da600c.jpg" alt="Escrita Anã">
                    <img src="https://sm.ign.com/ign_br/gallery/t/tales-of-t/tales-of-the-shire-june-2024-screenshots_vaj9.jpg" alt="Condado">
                </div>
                <button class="prev">&#10094;</button>
                <button class="next">&#10095;</button>
            </div>
            <br>
            <p><strong>"Nem todos os que vagam estão perdidos."</strong><br>
            Você já se sentiu intrigado pelas marcas misteriosas no Mapa de Thrór? 
            Ou tentou decifrar as inscrições nos túmulos de Moria? Na Academia de Erebor, o segredo das pedras é revelado.</p>

            <p><strong>As runas de Tolkien não são apenas desenhos decorativos; elas são sistemas de escrita complexos, com história, 
            fonética e alma. Na Academia de Runas, nós não apenas ensinamos você a escrever — nós ensinamos você a desvendar os segredos da Terra-média.</strong></p>
        </section>

        <section id="RF">
            <article>
                <h2>Runas Futhorc</h2>
                <p>As runas utilizadas por Thorin Escudo de Carvalho para encontrar a porta secreta da Montanha Solitária. Essenciais para qualquer explorador de tesouros.</p>
                <img src="https://shopretroworks.com/cdn/shop/products/MoonRunes_1200x1200.png?v=1463775156" alt="imgRF">
            </article>
        </section>

        <section id="RE">
            <article>
                <h2>Runas Élficas (Cirth)</h2>
                <p>A elegância dos primogênitos em forma de escrita. Criadas por Daeron de Doriath, estas runas representam
                     a harmonia e a história das eras antigas.</p>
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT8m6OWfzokrDbvny8tJUfMmxwajJOTQ3nvJg&s" alt="imgRE" style="scale: 1.3;">
                </article>
        </section>

        <section id="RA">
            <article>
                <h2>Runas Antigas</h2>
                <p>O estudo profundo das variantes do Angerthas e suas adaptações através das diferentes
                     linhagens de Anões e Elfos da Terra-média.</p>
                <img src="https://i0.wp.com/guarientoportal.com/wp-content/uploads/2022/01/Anel-Senhor-Dos-Aneis.jpg?fit=1191%2C670&ssl=1" alt="imgRA">
            </article>
        </section>

        <section id="PLA">
            <h2>Planos</h2>
            <article  id="planos">
                <section class="plans" style="background-color: #ffe5b7;">
                    <h2>Condado</h2>
                    <p>Com este plano você terá acesso a:</p><br>
                    <ul>
                        <li>Aulas Gravadas</li><br>
                        <li>Comunidade De Alunos</li><br>
                        <li>Certificados De Conclusão</li>
                    </ul><br><br>
                    <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ"><button class="btn">Assine Já</button></a>
                </section>
                <section class="plans" style="background-color: #ffcd76;">
                    <h2>Gondor</h2>
                    <p>Com este plano você terá acesso a:</p><br>
                    <ul>
                        <li>Todos Os Benefícios Do Condado</li><br>
                        <li>Aulas Online Com Professores Nativos</li><br>
                        <li>Exercícios Interativos</li>
                    </ul><br>
                    <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ"><button class="btn">Assine Já</button></a>
                </section>
                <section class="plans" style="background-color: #ffbd4a;">
                    <h2>Valfenda</h2>
                    <p>Com este plano você terá acesso a:</p><br>
                    <ul>
                        <li>Todos os Benefícios Anteriores</li><br>
                        <li>Aulas Particulares</li><br>
                        <li>Provas Com Premiações</li>
                    </ul><br><br>
                    <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ"><button class="btn">Assine Já</button></a>
                </section>
            </article>
        </section>
    </main>

    <footer>
        <p>Desenvolvido na Forja de Erebor &copy; 2026</p>
        <p><i>Linguística e Filologia da Terra-média</i></p>
    </footer>

    <script>
        const elemSlides = document.querySelector(".slides");
        const elemBtnPrev = document.querySelector(".prev");
        const elemBtnNext = document.querySelector(".next");
        const elemsImg = document.querySelectorAll(".slides img");

        const tamanhoLista = elemsImg.length - 1;
        let index = 0;

        elemBtnPrev.addEventListener('click', () => {
            index--;
            if (index < 0) index = tamanhoLista;
            atualizarCarrossel();
        });

        elemBtnNext.addEventListener('click', () => {
            index++;
            if (index > tamanhoLista) index = 0;
            atualizarCarrossel();
        });

        const atualizarCarrossel = () => {
            elemSlides.style.transform = `translateX(-${index * 100}%)`;
        }
    </script>
</body>
</html>
