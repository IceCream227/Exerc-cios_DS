<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        @font-face {
            font-family: 'Ringbearer';
            src: url('./ringbearer/RINGM___.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        @font-face {
            font-family: 'Celtic';
            src: url('./celtic_garamond_the_2nd/CELTG___.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        :root{
            --cor-fundo: #EEE0C7;
            --cor-header-footer: #636B2F;
            --cor-texto: #fff;
            --cor-box: #3f41385e;
            --cor-btn1: #7C4919;
            --cor-btn2: #EB8A2F;
            --cor-brilho: #F3B900;
        }

        * {
            padding: 0;
            margin: 0;
            box-sizing: border-box;
        }

        h1,h2,h3,span,p{
            color: var(--cor-texto);
        }

        h1,h2,h3{
            font-family: 'Ringbearer', serif;
        }
        p, span{
            font-family: 'Celtic', serif;
        }

        body{
            background-color: var(--cor-fundo);
        }

        header {
            background-color: var(--cor-header-footer);
            text-align: center;
            padding: 1.5rem;
            color: #FFF;
        }

        footer {
            background-color: var(--cor-header-footer);
            text-align: center;
            padding: 1.5rem;
            color: #fff;
        }

        .btn {
            background-color: var(--cor-btn1);
            border: none;
            transition: 0.5s ease;
            font-family: 'Celtic', serif;
            color: #ccc;
            padding: 0.313rem;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn:hover {
            background-color: var(--cor-btn2);
            color: var(--cor-texto);
            box-shadow: 0 1px 12px var(--cor-brilho);
        }

        #principal {
            background-color: var(--cor-box);
            text-align: center;
            border-radius: 4px;
            padding: 1.25rem;
            border-radius: 4px;
            width: 60vw;
            margin: 0 auto;
            margin-top: 1.25rem;
        }

        section {
            background-color: var(--cor-box);
            text-align: center;
            border-radius: 4px;
            padding: 1.25rem;
            border-radius: 4px;
            width: 60vw;
            margin: 0 auto;
            margin-top: 1.25rem;
            margin-bottom: 1.25rem;
        }

        .carousel-conteiner {
            max-width: 40vw;
            width: 100%;
            max-height: 35vw;
            height: 100%;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.25);
            border-radius: 10px;
            margin: 0 auto;
            position: relative;
        }

        .slides {
            display: flex;
            transition: transform 0.5s ease-in-out;
            transform: translateX(0);
        }

        .slides img {
            display: block;
            width: 100%;
            min-width: 100%;
            object-fit: cover;
        }

        button.prev,
        button.next {
            position: absolute;
            top: 50%;
            background-color: rgba(0, 0, 0, 0.767);
            color: white;
            border: none;
            padding: 0.313rem;
            cursor: pointer;
            font-size: 15px;
            z-index: 10;
            border-radius: 5px;
            margin: 0 10px;
            transition: transform 0.5s ease;
        }

        button:hover {
            transform: scale(1.1);
        }

        button:active {
            transform: scale(0.5);
        }

        .next {
            right: 0;
        }

        .prev {
            left: 0;
        }
        @media screen and (max-width: 820px) {
            .lista img{
                width: 30vw;
                opacity: 1;
            }
        }
        @media screen and (max-width: 768px) { 
            h1{
                font-size: 2rem;
            }
            h2{
                font-size: 1.75rem;
            }
            .lista img{
                width: 30vw;
                opacity: 1;
            }
            .carousel-conteiner{
                max-width: 100%;
                width: 80vw;
            }
        }
        @media screen and (max-width: 576px) {
            h1{
                font-size: 1.75rem;
            }
            h2{
                font-size: 1.45rem;
            }
            .lista img{
                width: 30vw;
                opacity: 1;
            }
            .carousel-conteiner{
                max-width: 100%;
                width: 80vw;
            }
        }
        @media screen and (max-width: 400px) {
            h1{
                font-size: 1.75rem;
            }
            h2{
                font-size: 1rem;
            }
            .lista img{
                width: 30vw;
                opacity: 1;
            }
            .carousel-conteiner{
                max-width: 100%;
                width: 80vw;
            }
        }


    </style>
</head>

<body>
    <header>
        <h1>The Lord Of Languages</h1>
        <nav>
            <a href="#RF"><button class="btn">Runas Futhroc</button></a><br><br>
            <a href="#RE"><button class="btn">Runas Élficas</button></a>
            <a href="#RA"><button class="btn">Runas Antigas</button></a>
        </nav>
    </header>

    <main>
        <section>
            <div class="carousel-conteiner">
                <div class="slides">
                    <img src="https://media2.giphy.com/media/v1.Y2lkPTZjMDliOTUybHF1anJ5bDlqeTRnYWlnb2xxdmd2cTNuanAwb2ZzcjVqemoxNXptaCZlcD12MV9naWZzX3NlYXJjaCZjdD1n/CNAhQuDceLwwo/giphy.gif"
                        alt="Slide 1">
                    <img src="data:image/jpeg;base64,"
                        alt="Slide 2">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/2/2f/Alfabeto_Tengwar.jpg"
                        alt="Slide 3">
                    <img src=""
                        alt="Slide 4">
                </div>
                <button class="prev">&#10094;</button>
                <button class="next">&#10095;</button>
            </div>
        </section>

        <section>
            <article id="RF">
                <h2>Runas Futhorc</h2>
            </article>
        </section>

        <section id="RE">
            <article>
                <h2>Runas Élficas</h2>
            </article>
        </section>

        <section id="RA">
            <article>
                <h2>Runas Antigas</h2>
            </article>
        </section>
    </main>

    <footer>
        <p>Spin Foot Of The Site</p>
        <p>Contact Informations, etc</p>
    </footer>
    <script>
        const elemSlides = document.querySelector(".slides");
        const elemBtnPrev = document.querySelector(".prev");
        const elemBtnNext = document.querySelector(".next");
        const elemsImg = document.querySelectorAll(".slides img");

        console.log(elemsImg.length);

        const tamanhoLista = elemsImg.length - 1;

        let index = 0;

        elemBtnPrev.addEventListener('click', () => {
            index--;
            if (index < 0) index = tamanhoLista;
            atualizarCarrossel();
            console.log(index);
        });
        elemBtnNext.addEventListener('click', () => {
            index++;
            if (index > tamanhoLista) index = 0;
            atualizarCarrossel();
            console.log(index);
        })

        const atualizarCarrossel = () => {
            elemSlides.style.transform = `translateX(-${index * 100}%)`;
        }
    </script>
</body>

</html>
